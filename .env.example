# ==============================================================================
# AIVOA PHARMACEUTICAL QUALITY COMPLAINT MANAGEMENT SYSTEM
# Production & Local Environment Configuration Template
# ==============================================================================

# Application Environment (development | test | production)
APP_ENV=development
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 1. AI ENGINE CONFIGURATION (Groq Cloud API)
# ------------------------------------------------------------------------------
# Get your API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Default primary extraction model (required by assignment specification)
GROQ_MODEL=gemma2-9b-it

# Fallback model (used transparently if primary model is unavailable or rate-limited)
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. PERSISTENCE CONFIGURATION (PostgreSQL / SQLite fallback)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for production / containerized runtime:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aivoa_complaints

# ------------------------------------------------------------------------------
# 3. SECURITY & CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins or JSON array format:
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost","http://localhost:80"]

# Maximum file upload size in bytes (default 10 MB = 10485760)
MAX_FILE_SIZE_BYTES=10485760
